{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ChordBook",
  "scopeName": "source.chordbook",
  "patterns": [
    { "include": "#comments" },
    { "include": "#custom-chord-defs" },
    { "include": "#metadata" },
    { "include": "#sections" },
    { "include": "#chord-lines" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.chordbook",
          "match": "(#|//).*$"
        }
      ]
    },
    "custom-chord-defs": {
      "patterns": [
        {
          "match": "^\\s*([A-G][b#♯♭]?(?:maj9|maj7|maj|min9|min7|min|m9|m7b5|m7|m6|m|7sus4|sus4|sus2|sus|dim7|dim|aug7|aug|add9|add2|add11|13|11|9|7|6|5|[+oøΔ])?(?:\\/[A-G][#b♯♭]?)?)\\s*(:)\\s*([xX0-9,\\s]{6,})\\s*$",
          "captures": {
            "1": { "name": "entity.name.function.chord.custom.chordbook" },
            "2": { "name": "punctuation.separator.key-value.chordbook" },
            "3": { "name": "constant.numeric.fretboard.fretdef.chordbook" }
          }
        }
      ]
    },
    "metadata": {
      "patterns": [
        {
          "match": "^([A-Za-z][A-Za-z0-9_-]*)\\s*(:)\\s*(.*)$",
          "captures": {
            "1": { "name": "keyword.other.metadata.key.chordbook" },
            "2": { "name": "punctuation.separator.key-value.chordbook" },
            "3": { "name": "string.unquoted.metadata.value.chordbook" }
          }
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "meta.section.header.bracket.chordbook",
          "match": "^\\s*(\\[)([^\\]]+)(\\])\\s*$",
          "captures": {
            "1": { "name": "punctuation.definition.heading.begin.chordbook" },
            "2": { "name": "entity.name.section.chordbook markup.heading" },
            "3": { "name": "punctuation.definition.heading.end.chordbook" }
          }
        },
        {
          "name": "meta.section.header.markdown.chordbook",
          "match": "^\\s*(={2,})\\s*([^=]+)\\s*(={2,})\\s*$",
          "captures": {
            "1": { "name": "punctuation.definition.heading.chordbook" },
            "2": { "name": "entity.name.section.chordbook markup.heading" },
            "3": { "name": "punctuation.definition.heading.chordbook" }
          }
        }
      ]
    },
    "chord-lines": {
      "patterns": [
        {
          "match": "^(?=[\\s|/%-]*[A-G](?:[#b♯♭])?(?:maj9|maj7|maj|min9|min7|min|m9|m7b5|m7|m6|m|7sus4|sus4|sus2|sus|dim7|dim|aug7|aug|add9|add2|add11|13|11|9|7|6|5|[+oøΔ])?(?:\\/[A-G][#b♯♭]?)?(?:\\s+[A-G|/%-]|$))(.*)$",
          "captures": {
            "1": {
              "patterns": [
                { "include": "#chord-tokens" },
                { "include": "#measure-bars" }
              ]
            }
          }
        }
      ]
    },
    "chord-tokens": {
      "patterns": [
        {
          "name": "entity.name.function.chord.chordbook",
          "match": "(?:^|(?<=\\s|[|/%~()\\[\\]]))([A-G][b#♯♭]?(?:maj9|maj7|maj|min9|min7|min|m9|m7b5|m7|m6|m|7sus4|sus4|sus2|sus|dim7|dim|aug7|aug|add9|add2|add11|13|11|9|7|6|5|[+oøΔ])?(?:\\/[A-G][b#♯♭]?)?)(?=\\s|[|/%~()\\[\\],.:]|$)"
        },
        {
          "name": "keyword.control.chord.nocord.chordbook",
          "match": "\\b(N\\.C\\.)\\b"
        }
      ]
    },
    "measure-bars": {
      "patterns": [
        {
          "name": "punctuation.separator.measure.chordbook",
          "match": "(\\|{1,2}|\\/|%|-)"
        }
      ]
    }
  }
}
